<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ title }}</title>
    <meta name="author" content="Omar Hossam" />
    <link rel="stylesheet" href="/css/pico.blue.min.css">
    <link rel="stylesheet" href="/css/globals.css">
    <link rel="apple-touch-icon" sizes="180x180" href="/icons/apple-touch-icon.png">
    <link rel="icon" type="image/png" sizes="32x32" href="/icons/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="/icons/favicon-16x16.png">
    <link rel="manifest" href="/icons/site.webmanifest">
    {%- for file in css %}
      <link rel="stylesheet" href="{{ file }}">
    {%- endfor %}
    <style>
        {{ style }}
    </style>
</head>
<body>
    {% include "../_components/navbar.njk" %}
    {% include "../_components/sidenav.njk" %}
    
    <main>
        {{ content | safe }}
    </main>
    
    {% if page.url !== '/requests/' %}
    <footer class="container" style="padding: 2rem 0; border-top: 1px solid var(--pico-muted-border-color);">
      <div class="grid">
        <div>
          <p><strong>CareBridge</strong><br><small>© 2026. Built for <a href="https://gnec-hackathon-2026-spring.devpost.com/" target="_blank">GNEC Spring 2026 Hackathon.</a></small></p>
        </div>
        <div style="text-align: right;">
          <a href="/" class="secondary">Home</a> | 
          <a href="/about" class="secondary">About</a> | 
          <a href="/requests" class="secondary">Requests</a> | 
          <a href="#" class="secondary">Contact</a>
        </div>
      </div>
    </footer>
    {% endif %}
    
    <script src="/js/helpers.js"></script>
    
    <!-- Firebase Import Map -->
    <script type="module">
      import { initializeApp } from "https://www.gstatic.com/firebasejs/10.8.0/firebase-app.js";
      import { getFirestore, doc, getDoc, updateDoc } from "https://www.gstatic.com/firebasejs/10.8.0/firebase-firestore.js";
      import { getAuth, onAuthStateChanged } from "https://www.gstatic.com/firebasejs/10.8.0/firebase-auth.js";
      import { autoSeed } from '/js/seeder.js';
    
      const firebaseConfig = {
        apiKey: "{{ firebase.apiKey }}",
        authDomain: "{{ firebase.authDomain }}",
        projectId: "{{ firebase.projectId }}",
        storageBucket: "{{ firebase.storageBucket }}",
        messagingSenderId: "{{ firebase.messagingSenderId }}",
        appId: "{{ firebase.appId }}"
      };

      // Initialize Firebase
      const app = initializeApp(firebaseConfig);
      window.db = getFirestore(app);
      window.auth = getAuth(app);
      
      window.getUserData = async (uid) => {
        const docRef = doc(window.db, "users", uid);
        const docSnap = await getDoc(docRef);
        if (docSnap.exists()) {
            return docSnap.data(); // Returns { name, role, email, etc }
        }
        return null;
      };
      
      window.payNow = async (requestId) => {
            // 1. Show a fake loading state
            const btn = event.target;
            btn.ariaBusy = "true";
            btn.textContent = "Processing Payment...";

            // 2. Simulate 2-second bank delay ⏳
            setTimeout(async () => {
                try {
                    // 3. Update Firestore status to 'funded'
                    const requestRef = doc(window.db, "requests", requestId);
                    await updateDoc(requestRef, {
                        status: 'funded',
                        fundedBy: window.auth.currentUser.uid
                    });

                    // 4. Success Message
                    alert("Payment Successful! You just saved a life.");
                    location.reload(); 
                } catch (err) {
                    alert("Payment failed: " + err.message);
                    btn.ariaBusy = "false";
                }
            }, 2000);
        };

        // Run the seeder
        autoSeed();
    </script>
    <script type="module" src="/js/nav-and-sidebars.js"></script>

    {%- for script in js %}
      <script type="module" src="{{ script }}"></script>
    {%- endfor %}
</body>
</html>
